{
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    }
  },
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 3 */9 * *"
    }
  ]
}
