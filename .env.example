# Copy to .env for local use, or set these in Vercel → Project → Settings → Environment Variables.

# Database. Leave unset locally to use the SQLite file data/ledger.db.
TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
TURSO_AUTH_TOKEN=

# Signs login cookies. Required with a remote database. Generate one: openssl rand -base64 32
SESSION_SECRET=

# Owner account, created automatically the first time the app starts on an empty database.
OWNER_NAME=Aakash
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-soon
